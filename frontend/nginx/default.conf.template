# ---------------------------------------------------------------------------
# Artha.AI frontend — nginx site config.
#
# Rendered by the base image's entrypoint: every ${ARTHA_*} placeholder is
# substituted from the environment at container start, so one built image works
# against any backend host/port without a rebuild. nginx's own runtime
# variables ($uri, $host, ...) survive because NGINX_ENVSUBST_FILTER=^ARTHA_.
# ---------------------------------------------------------------------------

upstream artha_gateway {
    server ${ARTHA_BACKEND_HOST}:${ARTHA_BACKEND_PORT};

    # The gateway is a single-worker process holding long-lived requests;
    # keeping connections warm avoids a fresh handshake per poll.
    keepalive 16;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Uploaded trial balances are real-world Excel exports and can be large.
    # nginx's 1m default would reject them as 413 before FastAPI ever saw the
    # request, which surfaces in the UI as an unexplained upload failure.
    client_max_body_size ${ARTHA_MAX_UPLOAD_SIZE};
    client_body_timeout  300s;

    # Do not advertise the exact nginx version.
    server_tokens off;

    include /etc/nginx/snippets/security-headers.conf;

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   5;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/xml application/javascript
                      application/json application/xml image/svg+xml
                      font/woff font/woff2;

    # Container-level liveness probe. Answered by nginx itself so it stays
    # green while the backend is still warming up.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # ── API proxy ──────────────────────────────────────────────────────────
    location /api/ {
        proxy_pass         http://artha_gateway;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # SAR generation runs 4 LLM calls; Trial Balance's single-TB pipeline
        # runs ~20 sequential tool calls, several of them their own LLM
        # reasoning steps. One generous shared timeout (matching the Vite dev
        # proxy's 30 minutes) rather than special-casing per path — a 60s
        # gateway default would 504 mid-report and look like a backend crash.
        proxy_connect_timeout ${ARTHA_PROXY_TIMEOUT};
        proxy_send_timeout    ${ARTHA_PROXY_TIMEOUT};
        proxy_read_timeout    ${ARTHA_PROXY_TIMEOUT};

        # Stream responses straight through. Buffering a multi-megabyte audit
        # workbook to a temp file first would also mean a read-only rootfs
        # could not serve it.
        proxy_buffering  off;
        proxy_request_buffering off;
    }

    # ── Static assets ──────────────────────────────────────────────────────
    # Vite fingerprints everything under /assets/, so those URLs are immutable
    # and safe to cache hard. Cache-Control is set only via add_header, never
    # alongside `expires` — `expires` emits its own Cache-Control, and the two
    # together send the header twice with different values, leaving which one
    # applies up to the client.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # index.html must never be cached: a stale copy would keep referencing the
    # previous build's fingerprinted asset filenames, which no longer exist,
    # and the app would come up blank after every deploy.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store, must-revalidate" always;
    }

    # SPA fallback — client-side routes are not files on disk.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
