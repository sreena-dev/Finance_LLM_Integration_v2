# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Environment — never commit real credentials.
# .env.example IS tracked; it is the same file with the credentials blanked.
.env
.env.local
.env.*.local
!.env.example

# Vendored wheels for non-PyPI dependencies (yukta). Binaries stay out of the
# repo — rebuild with scripts/build-yukta-wheel.sh; see backend/vendor/README.md,
# which is tracked so a fresh clone knows to run it.
backend/vendor/*.whl
backend/vendor/*.tar.gz

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Any mode's per-session uploads and generated pipeline artifacts
backend/modes/*/sessions/
backend/modes/*/pipeline/output/

# TB-v2 writes its run artifacts one level HIGHER than the patterns above —
# backend/modes/sessions/<session-id>/ and backend/modes/output/ — which
# `backend/modes/*/sessions/` does not match. These hold real trial-balance
# data for named entities (canonical_tb.parquet, fsli_summary, layer1_*), so
# leaving them unignored would push client financial data to a public remote.
backend/modes/sessions/
backend/modes/output/

# Generated by `python -m scripts.audit_fs_entities --json` — a corpus dump of
# every entity and its filing coverage. A diagnostic report, not source; nothing
# in the app reads it.
backend/fs_entities.json

FIN_LLM/


