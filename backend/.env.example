# ---------------------------------------------------------------------------
# Artha.AI integrated backend — copy to backend/.env and fill in.
#
# All pipelines read their settings from this one file (app/main.py loads it
# before importing any mode), so each mode's variables are kept in its own
# block below.
# ---------------------------------------------------------------------------


# ===========================================================================
# MODE: Financial Statements   (branch: Financial_Statement)
# ===========================================================================

# Rules / standards database. DB_PASSWORD is REQUIRED — the branch's Config
# class raises at import time without it, which takes this mode offline.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_llm
DB_USER=financial_llm
DB_PASSWORD=

# Annual-reports database. Optional: if unset, this mode still serves rules-DB
# answers and simply skips the reporting-framework tool.
REPORTS_DB_HOST=localhost
REPORTS_DB_PORT=5432
REPORTS_DB_NAME=finance_llm
REPORTS_DB_USER=bfl
REPORTS_DB_PASSWORD=

# Generation / reranking endpoints
LLM_BASE_URL=http://localhost:8000
LLM_MODEL_NAME=gemma-4-31b
RERANKER_BASE_URL=http://localhost:8002
RERANKER_MODEL=bge-reranker

# Retrieval tuning
TOP_K_PER_TABLE=10
TOP_K_PRE_RERANK=50
TOP_K_OVERALL=15
SIMILARITY_THRESHOLD=0.0
MAX_TOOL_ITERATIONS=8


# ===========================================================================
# MODE: Statutory Auditor's Report   (branch: Statutory_Auditor_Report)
# ===========================================================================

# REQUIRED. Also what powers the entity / financial-year dropdowns — they are
# read straight from the `documents` table, so with this set the dropdowns work
# even if the LLM endpoint below is unreachable.
FINANCE_DSN=postgresql://user:password@localhost:5432/finance_db

# Standards reference DB used for SA / CARO context lookups. Optional.
REFERENCE_DSN=

# Generation endpoint for the 3 extractor agents + report writer.
GENERATION_BASE_URL=http://localhost:8000
GENERATION_MODEL=gemma-4-26b-a4b-it
GENERATION_TIMEOUT=300


# ===========================================================================
# MODE: Trial Balance   (source: Finance_llm_v2_naveen, main branch)
# ===========================================================================

# Storage for uploaded trial balances (`tb_input_data` table, auto-created).
# Reuses the SAME database as SAR's FINANCE_DSN above — set this to the same
# value. If left unset, the vendored pipeline's own hardcoded default is used.
FINANCE_LLM_DSN=

# Ind AS / Schedule III / SA 700 / CARO reference corpora, used by `ask` and
# `audit`. Reuses SAR's REFERENCE_DSN above — no separate value needed here.

# Embedding endpoint for Ind AS retrieval. Same physical server as
# EMBEDDING_BASE_URL below, but this pipeline expects the FULL path (including
# /v1/embeddings) in one var rather than a bare base URL + separate model var.
EMBEDDING_URL=

# Generation endpoint for the `ask` and `audit` agents. Deliberately NOT named
# GENERATION_BASE_URL/GENERATION_MODEL — SAR already owns those names above,
# and Trial Balance's default endpoint/model differ from SAR's. If left unset,
# the vendored pipeline's own hardcoded default is used.
TB_GENERATION_BASE_URL=
TB_GENERATION_MODEL=


# ===========================================================================
# Shared by all modes
# ===========================================================================

# NOTE: Financial Statements and SAR read these same two names. If your modes
# need different embedding endpoints, they must be reconciled before running
# them together.
EMBEDDING_BASE_URL=http://localhost:8001/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# Arize Phoenix tracing (optional)
ENABLE_TRACING=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=artha-ai
PHOENIX_LAUNCH_LOCAL=false
