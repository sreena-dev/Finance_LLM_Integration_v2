# ---------------------------------------------------------------------------
# Artha.AI integrated backend.
#
# !! THIS FILE IS INCOMPLETE. Prefer the .env.example at the REPOSITORY ROOT. !!
#
# app/main.py loads `backend/.env` FIRST and stops there if it exists, so a
# backend/.env copied from this file means the root .env is never read at all.
# This file is missing every TB_DB_* variable (Trial Balance then silently falls
# back to localhost:5433 with no user), GENERATION_API_KEY, TZ and the whole
# ARTHA_* deployment block, and it still declares two retired names
# (EMBEDDING_URL, FINANCE_LLM_DSN).
#
# Copy the ROOT .env.example to the repo root as .env instead. Use this file
# only if you deliberately want backend-local settings, and reconcile it against
# the root one first.
# ---------------------------------------------------------------------------


# ===========================================================================
# MODE: Financial Statements   (branch: Financial_Statement)
# ===========================================================================

# Rules / standards database. DB_PASSWORD is REQUIRED — the branch's Config
# class raises at import time without it, which takes this mode offline.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_llm
DB_USER=financial_llm
DB_PASSWORD=

# Annual-reports database. Optional: if unset, this mode still serves rules-DB
# answers and simply skips the reporting-framework tool.
REPORTS_DB_HOST=localhost
REPORTS_DB_PORT=5432
REPORTS_DB_NAME=finance_llm
REPORTS_DB_USER=bfl
REPORTS_DB_PASSWORD=

# Generation / reranking endpoints
LLM_BASE_URL=http://localhost:8000
LLM_MODEL_NAME=gemma-4-31b
RERANKER_BASE_URL=http://localhost:8002
RERANKER_MODEL=bge-reranker

# Retrieval tuning
TOP_K_PER_TABLE=10
TOP_K_PRE_RERANK=50
TOP_K_OVERALL=15
SIMILARITY_THRESHOLD=0.0
MAX_TOOL_ITERATIONS=8


# ===========================================================================
# MODE: Statutory Auditor's Report   (branch: Statutory_Auditor_Report)
# ===========================================================================

# REQUIRED. Also what powers the entity / financial-year dropdowns — they are
# read straight from the `documents` table, so with this set the dropdowns work
# even if the LLM endpoint below is unreachable.
FINANCE_DSN=postgresql://user:password@localhost:5432/finance_db

# Standards reference DB used for SA / CARO context lookups. Optional.
REFERENCE_DSN=

# Generation endpoint for the 3 extractor agents + report writer.
GENERATION_BASE_URL=http://localhost:8000
GENERATION_MODEL=gemma-4-26b-a4b-it
GENERATION_TIMEOUT=300


# ===========================================================================
# MODE: Trial Balance   (source: Finance_llm_v2_naveen, main branch)
# ===========================================================================

# Storage for uploaded trial balances (`tb_input_data` table, auto-created).
# Reuses the SAME database as SAR's FINANCE_DSN above — set this to the same
# value. If left unset, the vendored pipeline's own hardcoded default is used.
FINANCE_LLM_DSN=

# Ind AS / Schedule III / SA 700 / CARO reference corpora, used by `ask` and
# `audit`. Reuses SAR's REFERENCE_DSN above — no separate value needed here.

# Embedding endpoint for Ind AS retrieval. Same physical server as
# EMBEDDING_BASE_URL below, but this pipeline expects the FULL path (including
# /v1/embeddings) in one var rather than a bare base URL + separate model var.
EMBEDDING_URL=

# Generation endpoint for the `ask` and `audit` agents. Deliberately NOT named
# GENERATION_BASE_URL/GENERATION_MODEL — SAR already owns those names above,
# and Trial Balance's default endpoint/model differ from SAR's. If left unset,
# the vendored pipeline's own hardcoded default is used.
TB_GENERATION_BASE_URL=
TB_GENERATION_MODEL=


# ===========================================================================
# Shared by all modes
# ===========================================================================

# NOTE: Financial Statements and SAR read these same two names. If your modes
# need different embedding endpoints, they must be reconciled before running
# them together.
EMBEDDING_BASE_URL=http://localhost:8001/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# Arize Phoenix tracing (optional)
ENABLE_TRACING=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=artha-ai
PHOENIX_LAUNCH_LOCAL=false

# ===========================================================================
# Authentication   (gateway-wide sign-up / sign-in)
# ===========================================================================

# Signing key for session tokens. REQUIRED — without it every request is
# rejected with a 503 saying so.
#
# Not auto-generated at boot, deliberately: a random per-process secret would
# silently sign everyone out on every restart, and with more than one replica a
# token issued by one would never validate at another. Generate once with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# and keep it identical across replicas. Changing it signs everyone out.
ARTHA_JWT_SECRET=CHANGE-ME-generate-with-secrets.token_urlsafe-48

# How long a session lasts before the UI returns to the sign-in screen.
# Clamped to [0.25, 720] hours.
ARTHA_JWT_TTL_HOURS=12

# Where the two new tables (artha_users, artha_fs_messages) live. Unset, they
# use FINANCE_DSN — the same finance_llm database SAR and FDR already read.
# Set this only to move accounts and chat history to a separate database.
# ARTHA_DB_DSN=
# ARTHA_DB_POOL_MIN=1
# ARTHA_DB_POOL_MAX=5


# ===========================================================================
# Financial Statements — entity resolution
# ===========================================================================

# How long the company list read from `documents` is reused before being
# re-read, in seconds. 0 disables caching. Only affects how soon a NEWLY
# ingested company becomes askable; it never changes which company a name
# resolves to.
ARTHA_FS_ENTITY_CACHE_TTL=300

# Set to 1 to let the Financial Statements mode come up GREEN when the reports
# database is unreachable. Off by default and it should stay off: without that
# database the 18 company tools are never registered, and the mode answers every
# company question by saying the data is unavailable — which reads as "this
# company disclosed nothing" rather than "the database is down".
# ARTHA_FS_ALLOW_NO_REPORTS_DB=0
