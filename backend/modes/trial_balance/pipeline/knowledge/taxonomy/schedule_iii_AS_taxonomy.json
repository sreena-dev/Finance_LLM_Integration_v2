  "_meta": {
    "source": "Companies Act 2013, Schedule III, Division I (Companies (Accounting Standards) Rules, 2006 / AS)",
    "purpose": "Closed classification taxonomy for TB grouping of companies following AS (not Ind AS). Use ONLY for companies confirmed to follow AS - see accounting_standard_detect.py.",
    "fields": ["BS/PL", "MAIN HEAD", "SUB HEAD 1", "SUB HEAD 2"],
    "account_type_rule": "Same derivation rule as Ind AS: BS+asset-ish MAIN HEAD -> Asset; BS+liabilit-ish -> Liability; BS+Shareholders' funds -> Equity; PL+Revenue/Other income -> Income; PL+Expenses -> Expense",
    "key_differences_from_ind_as": [
      "No 'Financial Assets' / 'Financial Liabilities' grouping - items sit directly under Non-current/Current assets or liabilities",
      "No Other Comprehensive Income concept",
      "No Statement of Changes in Equity as a primary statement",
      "Equity is 'Shareholders' funds' (Share capital, Reserves and surplus) not 'Equity'/'Other Equity'",
      "PPE is called 'Tangible assets' not 'Property, Plant and Equipment'",
      "Trade receivables sub-classified as Secured/Unsecured/Doubtful only (no ECL staging)",
      "P&L includes 'Extraordinary items' and 'Exceptional items' as separate lines"
    ]
  },
