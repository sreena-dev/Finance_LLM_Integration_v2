# -------------------------------------------------------------------------
# Artha.AI — Integrated Audit Platform: configuration template.
#
#     cp .env.example .env      # then fill in the credentials below
#
# ONE file configures everything: the FastAPI gateway loads it directly
# (app/main.py, before importing any mode), Docker Compose feeds it to the
# backend container via env_file and reads the ARTHA_* names to build the
# stack, and vite.config.js reads it for the dev server's ports and proxy.
#
# Values left as *.internal placeholders or blank must be filled in. Ports,
# timezone and tuning values are real defaults — use them as they stand.
# -------------------------------------------------------------------------

DB_HOST=db.internal
DB_PORT=5432
DB_NAME=financial_llm
DB_USER=financial_llm
DB_PASSWORD=
 
# Annual-reports database. Optional: if unset, this mode still serves rules-DB
# answers and simply skips the reporting-framework tool.
REPORTS_DB_HOST=db.internal
REPORTS_DB_PORT=5432
REPORTS_DB_NAME=finance_llm
REPORTS_DB_USER=bfl
REPORTS_DB_PASSWORD=
 
# Generation / reranking endpoints (bare base URLs — the pipeline appends
# /v1/chat/completions and /rerank respectively)
LLM_BASE_URL=http://llm.internal:8000
LLM_MODEL_NAME=gemma-4-26b-a4b-it
RERANKER_BASE_URL=http://rerank.internal:8002
RERANKER_MODEL=bge-reranker
 
# Retrieval tuning
TOP_K_PER_TABLE=10
TOP_K_PRE_RERANK=50
TOP_K_OVERALL=15
SIMILARITY_THRESHOLD=0.0
MAX_TOOL_ITERATIONS=8
 
 
# ===========================================================================
# MODE: Statutory Auditor's Report   (branch: Statutory_Auditor_Report)
# ===========================================================================
 
# REQUIRED. Also what powers the entity / financial-year dropdowns — they are
# read straight from the `documents` table, so with this set the dropdowns work
# even if the LLM endpoint below is unreachable.
FINANCE_DSN=postgresql://user:password@db.internal:5432/finance_llm
 
# Standards reference DB used for SA / CARO context lookups. Optional.
REFERENCE_DSN=postgresql://user:password@db.internal:5432/reference_db
 
# Generation endpoint for the 3 extractor agents + report writer.
GENERATION_BASE_URL=http://llm.internal:8000
GENERATION_MODEL=gemma-4-26b-a4b-it
GENERATION_TIMEOUT=300

# Bearer token for the generation endpoint. Sent as `Authorization: Bearer ...`
# by every generation client. Leave EMPTY for an endpoint that needs no auth —
# no header is added then, which is what the embedding and reranker servers
# expect. Not shared with those two: they are separate servers on a separate
# host and neither asks for a key.
GENERATION_API_KEY=
 
 
# ===========================================================================
# MODE: Trial Balance   (source: TB-v2)
# ===========================================================================
#
# TB-v2 keeps its own separate Postgres instance rather than the gateway's
# shared finance_llm DB (same "second DB reachable via host.docker.internal"
# pattern the old Trial Balance mode's PDF-evidence sub-feature already used).
# Every name below is TB_-prefixed (or reuses a name already reserved here,
# e.g. TB_GENERATION_BASE_URL) to avoid colliding with Financial Statement's
# own bare DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD/LLM_BASE_URL, which
# point at a different database and LLM endpoint entirely.

# TB-v2's own Postgres (its own schema.sql — document_table, tb_table,
# live_document_table, live_tb_table, pipeline_sessions, pipeline_findings,
# pipeline_artifacts). In the container, TB_DB_HOST must be
# host.docker.internal (mapped by the backend service's existing extra_hosts
# entry, the same mapping the old UPLOADS_DSN already relied on); running
# uvicorn directly on the host instead, use localhost.
TB_DB_HOST=host.docker.internal
TB_DB_PORT=5433
TB_DB_NAME=trial_balance_db
TB_DB_USER=
TB_DB_PASSWORD=
TB_DB_POOL_MIN=1
TB_DB_POOL_MAX=5

# Generation endpoint for `ask`/`audit`. Kept separate from SAR's
# GENERATION_BASE_URL/GENERATION_MODEL above, which point at a different
# endpoint/model. The model name is also echoed verbatim in the audit report's
# Run log ("Model version"), so it is part of that document's provenance.
#
# The model MUST exist on the endpoint you point at. `curl <base>/v1/models`
# first: a name the server does not serve fails as a 404 on every call.
TB_GENERATION_BASE_URL=http://llm.internal:30004
TB_GENERATION_MODEL=gemma-4-26b-a4b-it
TB_LLM_API_KEY=not-needed
TB_HTTP_TIMEOUT=120

# Where audit-run artifacts (canonical TBs, reports, session state) are
# written. The backend container's root filesystem is read-only; only the
# artha-data named volume (mounted at /var/lib/artha, already used by yukta's
# own session storage) and /tmp are writable. Defaults into that persistent
# volume so a run's outputs survive a container restart the same way yukta's
# chat sessions already do.
# TB_OUTPUT_DIR=/var/lib/artha/trial-balance

# Max tokens the LLM agent's assembled system prompt + tool schemas may reach
# before a warning is logged, and which tool domains the agent may choose
# between. The upload path (router.py's /upload-mapped) deterministically calls
# ingest_tb_to_live itself now — no agent tool-chaining needed for ingestion.
# canonical stays required for the agent's own post-ingestion analytics flow.
# Leave both unset for the vendored defaults.
# TB_SYSTEM_PROMPT_MAX_TOKENS=2048
# TB_AGENT_TOOL_DOMAINS=chat,db_bridge,input,canonical

# Native classification engine's embedding endpoint (taxonomy candidate
# retrieval). NOT the same knob as the shared EMBEDDING_BASE_URL below — this
# one is POSTed to directly as the full request URL (must already end in the
# right path, e.g. "/embeddings"), while the shared var is a bare base URL each
# of its own readers appends a path to. Leave unset for the vendored default.
# TB_EMBEDDING_BASE_URL=http://embed.internal:11652/embeddings
# TB_EMBEDDING_MODEL=BAAI/bge-m3
# TB_EMBEDDING_API_KEY=EMPTY
# TB_EMBEDDING_DIM=1024

# Hot-state/cache/coordination plane (preview tokens, per-session agent memory,
# chat result cache). Enabled by default — every helper degrades gracefully to
# a no-op if Valkey is unreachable, so a dev machine without it running does
# not crash. BUT: the preview-token store is load-bearing, not just caching —
# it's what bridges POST /upload -> POST /upload-mapped (the file's parsed
# preview has to survive between those two calls). If Valkey silently no-ops
# (wrong/missing password against a real, auth-protected instance — check for
# "[valkey] ... degrading to no-op: Authentication required" in the backend
# log), uploads will 404 on /upload-mapped even though /upload itself succeeds.
# If a platform-shared Valkey/Redis already exists (see the unprefixed
# VALKEY_* vars above, used by yukta's own session storage), point TB at the
# same host/port/password but give it its own TB_VALKEY_DB number so its
# unprefixed preview:/failedcall:/chatcache:/agentchat: keys can't collide
# with anything else using DB 0.
TB_VALKEY_HOST=localhost
TB_VALKEY_PORT=6379
TB_VALKEY_DB=1
TB_VALKEY_ENABLED=true
TB_VALKEY_PASSWORD=

# Durable artifact plane (MinIO/S3). Disabled by default — a clean checkout
# keeps working as pure local-filesystem-only until an operator opts in.
TB_MINIO_ENDPOINT=http://localhost:9000
TB_MINIO_ACCESS_KEY=
TB_MINIO_SECRET_KEY=
TB_MINIO_BUCKET=tb-artifacts
TB_MINIO_ENABLED=false


# ===========================================================================
# Shared by all modes
# ===========================================================================
 
# Both pipelines read these two names, but they disagree on the URL's shape:
# SAR appends "/v1/embeddings" to it, while the Financial Statement pipeline
# POSTs to it verbatim. Set the BARE base URL here (what SAR needs); the
# Financial Statement adapter appends the path for its own pipeline.
EMBEDDING_BASE_URL=http://embed.internal:8001
EMBEDDING_MODEL=bge-m3
 
# Arize Phoenix tracing (optional)
ENABLE_TRACING=true
PHOENIX_PROTOCOL=http/protobuf
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=artha-ai
PHOENIX_LAUNCH_LOCAL=false

# ===========================================================================
# Deployment   (read by docker-compose.yml, both Dockerfiles and vite.config.js)
#
# Nothing below is a credential. These are the knobs that decide where the
# stack listens and how it behaves under load — kept in this same file so
# there is exactly one place to look, for code and for containers alike.
# ===========================================================================

# --- Timezone -------------------------------------------------------------
# Applied inside BOTH images (tzdata + /etc/localtime) and exported as TZ, so
# container logs, Python's datetime.now() and nginx's access log all agree.
# IST is the operating timezone: the pipelines derive financial-year
# boundaries from "now", and a UTC container silently shifts every date after
# 18:30 IST into the previous day.
TZ=Asia/Kolkata

# --- Ports: one contiguous 121xx series -----------------------------------
# Deliberately a single reserved block rather than convenient defaults. This
# host already runs many compose projects across 8000-11999 (8080, 8090, 8600,
# 5173, 6006, 4317 are all taken), and because the API port is a *proxy
# target*, a collision shows up as a puzzling 404 from somebody else's service
# instead of a connection error.
ARTHA_FRONTEND_PORT=12100
ARTHA_BACKEND_PORT=12101

# Vite dev server / `npm run preview`, for running the UI outside Docker.
ARTHA_DEV_PORT=12103
ARTHA_PREVIEW_PORT=12104

# Phoenix tracing — only published under `--profile tracing`.
ARTHA_PHOENIX_UI_PORT=12106
ARTHA_PHOENIX_OTLP_PORT=12107

# Host interface the published ports bind to. 0.0.0.0 exposes the stack on the
# LAN; use 127.0.0.1 to keep it local-only behind an external reverse proxy.
ARTHA_BIND_HOST=0.0.0.0

# --- Gateway runtime ------------------------------------------------------
# Keep this at 1. Trial Balance's `ask` mode holds conversation memory in an
# in-process SessionStore and each mode's pipeline is imported lazily into
# whichever worker first serves it; a second worker scatters follow-up
# questions across processes that do not share that memory and duplicates
# every pipeline's resident footprint. Scale with replicas, not workers.
ARTHA_BACKEND_WORKERS=1
ARTHA_LOG_LEVEL=info
ARTHA_KEEPALIVE_TIMEOUT=75

# Comma-separated browser origins allowed to call the API cross-origin. Leave
# EMPTY for both supported deployments — Vite proxies /api in dev and nginx
# proxies it in the container, so the browser is always same-origin and no
# CORS header is needed. Only fill this in if you serve the UI from a
# different origin than the gateway.
ARTHA_CORS_ALLOW_ORIGINS=

# --- Proxy / upload limits ------------------------------------------------
# 30 minutes, matching the Vite dev proxy: SAR generation runs 4 LLM calls and
# the Trial Balance single-TB pipeline runs ~20 sequential tool calls. nginx's
# 60s default would 504 mid-report and look like a backend crash.
ARTHA_PROXY_TIMEOUT=1800s
ARTHA_PROXY_TIMEOUT_MS=1800000

# Real-world Excel trial-balance exports exceed nginx's 1m default, which would
# reject them as a 413 before FastAPI ever saw the request.
ARTHA_MAX_UPLOAD_SIZE=64m

# --- Resource limits ------------------------------------------------------
# The gateway loads pandas + three agent pipelines into one process and holds
# whole trial balances in memory while auditing them; 6g is headroom for the
# largest workbooks, not a typical figure.
ARTHA_BACKEND_CPU_LIMIT=4.0
ARTHA_BACKEND_MEM_LIMIT=6g
ARTHA_BACKEND_MEM_RESERVATION=1g
ARTHA_FRONTEND_CPU_LIMIT=1.0
ARTHA_FRONTEND_MEM_LIMIT=256m
ARTHA_PHOENIX_MEM_LIMIT=2g

# Both containers run with a read-only root filesystem; this is the tmpfs that
# backs /tmp for Python's own scratch use.
ARTHA_TMPFS_SIZE=512m

# --- Log rotation ---------------------------------------------------------
# Without a cap, a container logging one line per LLM call fills the host disk
# slowly and invisibly over a few months.
ARTHA_LOG_MAX_SIZE=20m
ARTHA_LOG_MAX_FILES=5

# --- Image build ----------------------------------------------------------
ARTHA_VERSION=1.0.0
ARTHA_PYTHON_VERSION=3.11
ARTHA_NODE_VERSION=20
ARTHA_NGINX_VERSION=1.27
ARTHA_PHOENIX_VERSION=version-11.44

# Set to 1 only to build without the vendored yukta wheel. yukta is not on
# PyPI; build it with scripts/build-yukta-wheel.sh. Without it Financial
# Statements, SAR report generation and TB ask/audit all report themselves
# unavailable — 3 of the 4 modes.
ARTHA_ALLOW_MISSING_YUKTA=0

# --- Container networking -------------------------------------------------
# Both services share Docker's existing default bridge and allocate no new
# subnet: this host's automatic pools are exhausted, and the only free block
# overlaps 192.168.200.0/24 — the LAN where the Postgres, embedding and
# reranker servers live — so a dedicated network could have black-holed them.
#
# The default bridge has no container-name DNS, so nginx reaches the gateway
# through the host gateway on the backend's published port. This makes
# ARTHA_BIND_HOST load-bearing: 0.0.0.0 works, 127.0.0.1 would break the
# frontend's /api proxy. To keep the API off the LAN, firewall the port
# instead of narrowing the bind address.
ARTHA_BACKEND_HOST=host.docker.internal

# Size of the tmpfs backing HOME (/home/artha) in the backend container.
# Scratch space only: yukta's durable state goes to the artha-data volume via
# YUKTA_DATA_DIR. This exists so that a dependency reaching for ~/.cache cannot
# fail a pipeline on the read-only rootfs.
ARTHA_HOME_TMPFS_SIZE=64m

# ===========================================================================
# Authentication   (gateway-wide sign-up / sign-in)
# ===========================================================================

# Signing key for session tokens. REQUIRED — without it every request is
# rejected with a 503 saying so.
#
# Not auto-generated at boot, deliberately: a random per-process secret would
# silently sign everyone out on every restart, and with more than one replica a
# token issued by one would never validate at another. Generate once with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# and keep it identical across replicas. Changing it signs everyone out.
ARTHA_JWT_SECRET=CHANGE-ME-generate-with-secrets.token_urlsafe-48

# How long a session lasts before the UI returns to the sign-in screen.
# Clamped to [0.25, 720] hours.
ARTHA_JWT_TTL_HOURS=12

# Where the two new tables (artha_users, artha_fs_messages) live. Unset, they
# use FINANCE_DSN — the same finance_llm database SAR and FDR already read.
# Set this only to move accounts and chat history to a separate database.
# ARTHA_DB_DSN=
# ARTHA_DB_POOL_MIN=1
# ARTHA_DB_POOL_MAX=5


# ===========================================================================
# Financial Statements — entity resolution
# ===========================================================================

# How long the company list read from `documents` is reused before being
# re-read, in seconds. 0 disables caching. Only affects how soon a NEWLY
# ingested company becomes askable; it never changes which company a name
# resolves to.
ARTHA_FS_ENTITY_CACHE_TTL=300

# Set to 1 to let the Financial Statements mode come up GREEN when the reports
# database is unreachable. Off by default and it should stay off: without that
# database the 18 company tools are never registered, and the mode answers every
# company question by saying the data is unavailable — which reads as "this
# company disclosed nothing" rather than "the database is down".
# ARTHA_FS_ALLOW_NO_REPORTS_DB=0

# --- FDR reranker ---------------------------------------------------------
# The Financial Diagnostic Report mode now uses the SAME reranker service the
# Financial Statement mode does (RERANKER_BASE_URL / RERANKER_MODEL above), so
# there is nothing to set here for the normal deployment. It previously loaded
# a 2.2GB cross-encoder from the local Hugging Face cache and, on a machine
# without one, logged a "couldn't connect to huggingface.co" warning and fell
# back to unranked order.
#
# Override only to point FDR at a different reranker than the other modes:
# FDR_RERANK_URL=
# FDR_RERANK_MODEL=
# FDR_RERANK_TIMEOUT=30

# Characters of each passage sent to the reranker. Derived from the model's
# 512-token window; set this only if your endpoint has a different one.
# Measured on this corpus: 1,800 chars scored a relevant passage at -0.64 while
# 1,400 scored it at -2.90 and abstained, and 2,200 exceeded the window. Too
# SMALL is the dangerous direction -- it discards the answer and turns an
# answerable question into a confident "not answerable".
# FDR_RERANK_PASSAGE_CHARS=1809

# A candidate below this logit is not evidence, and a question with none above
# it abstains rather than being answered from whatever ranked least badly.
# Raise it to abstain more readily, lower it to answer more readily.
# FDR_RERANK_MIN_LOGIT=-1.0
